<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FunctionExplorer</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FunctionExplorer.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
    <script defer src="~/js/valem-latex.js" asp-append-version="true"></script>
    <script defer src="~/js/katex-init.js" asp-append-version="true"></script>
</head>
<body>
    <header class="sticky-top bg-white">
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">FunctionExplorer</a>
                <button class="btn btn-outline-secondary btn-sm d-md-none" type="button"
                        data-bs-toggle="collapse" data-bs-target="#kylgriba"
                        aria-controls="kylgriba" aria-expanded="false">Funktsioonid</button>
                <ul class="navbar-nav flex-row gap-3 ms-auto">
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Teooria</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Funktsioonid" asp-action="Index">Tabel</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <div class="app-paigutus">
        <aside class="kylgriba collapse d-md-block" id="kylgriba">
            @await Component.InvokeAsync("FunktsioonideKylgriba")
        </aside>
        <main role="main" class="sisu">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - FunctionExplorer
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/kylgriba.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
