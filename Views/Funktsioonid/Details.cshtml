@model FunctionExplorer.Models.FunktsiooniUurimine
<h1>f(x) = @Model.Valem</h1>
<dl class="row">
    <dt class="col-sm-3">Määramispiirkond</dt>
    <dd class="col-sm-9">@Model.Maaramispiirkond</dd>
    <dt class="col-sm-3">Nullkohad</dt>
    <dd class="col-sm-9">@Model.Nullkohad</dd>
    <dt class="col-sm-3">Tuletis f'(x)</dt>
    <dd class="col-sm-9">@Model.Tuletis</dd>
    <dt class="col-sm-3">Kriitilised punktid</dt>
    <dd class="col-sm-9">@Model.KriitilisedPunktid</dd>
    <dt class="col-sm-3">Ekstreemumid</dt>
    <dd class="col-sm-9">@Model.Ekstreemumid</dd>
</dl>

<div class="mb-2 d-flex align-items-center gap-2">
    <button id="lahtesta" class="btn btn-sm btn-secondary">Taasta</button>
    <small class="text-muted">Suumimiseks kerige, pildi nihutamiseks lohistage, taastamiseks topeltklõpsake</small>
</div>
<canvas id="funktsiooniGraafik" width="600" height="400"></canvas>
<p class="mt-3"><a asp-action="Index">Tagasi nimekirja</a></p>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7"></script>
    <script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1"></script>
    <script src="~/js/graafik.js"></script>
    <script>
        const valem = @Json.Serialize(Model.Valem);
        joonista(valem);
        document.getElementById('lahtesta').addEventListener('click', lahtestaVaade);
    </script>
}