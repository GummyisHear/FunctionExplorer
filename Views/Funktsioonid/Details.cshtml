@model FunctionExplorer.Models.DetailideVaade
@{
    var u = Model.Uurimine;
    var lisa = Model.Lisa;
    ViewData["Title"] = "f(x) = " + u.Valem;

    List<string> L(params string[] s) => s.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();

    // (sildi tekst, väärtused, lahenduskäigu number lisa.Sammud listis)
    var read = new List<(string Silt, List<string> Vaartused, int Samm)>
    {
        ("Määramispiirkond", L(u.Maaramispiirkond), 0),
        ("Nullkohad", L(u.Nullkohad), 1),
        ("Tuletis f'(x)", L("$$⟦" + (lisa?.Tuletis ?? u.Tuletis) + "⟧$$"), 2),
        ("Kriitilised punktid", L(u.KriitilisedPunktid), 3),
        ("Kasvamine ja kahanemine", lisa?.KasvamineLuhike ?? new List<string>(), 4),
        ("Ekstreemumid", u.Ekstreemumid.Split("; ").ToList(), 5),
        ("Teine tuletis f''(x)", lisa == null ? new List<string>() : L("$$⟦" + lisa.TeineTuletis + "⟧$$"), 6),
        ("Käänupunktid ja kumerus", lisa == null ? new List<string>() : L("Käänupunktid: " + lisa.Kaanupunktid).Concat(lisa.KumerusLuhike).ToList(), 7)
    };
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0 me-auto">$f(x) = ⟦@(u.Valem)⟧$</h1>
    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-warning">Muuda</a>
    <form asp-action="Delete" asp-route-id="@u.Id" method="post" onsubmit="return confirm('Kustutada?');">
        <button class="btn btn-sm btn-danger">Kustuta</button>
    </form>
    <a asp-action="Index" class="btn btn-sm btn-link">Tagasi</a>
</div>

<div class="row g-4">
    <div class="col-xl-6 order-2 order-xl-1">
        <div class="analuus">
            @for (int i = 0; i < read.Count; i++)
            {
                var r = read[i];
                if (r.Vaartused.Count == 0) { continue; }
                var samm = lisa != null && r.Samm < lisa.Sammud.Count ? lisa.Sammud[r.Samm] : null;
                <div class="analuus-rida">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="min-w-0">
                            <div class="analuus-silt">@r.Silt</div>
                            @foreach (var v in r.Vaartused)
                            {
                                <div class="analuus-vaartus">@v</div>
                            }
                        </div>
                        @if (samm != null)
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 text-nowrap"
                                    data-bs-toggle="collapse" data-bs-target="#samm-@i"
                                    aria-expanded="false" aria-controls="samm-@i">Näita lahendus</button>
                        }
                    </div>
                    @if (samm != null)
                    {
                        <div class="collapse" id="samm-@i">
                            <div class="lahendus-kast">
                                <p>@samm.Selgitus</p>
                                @if (samm.Read.Count > 0)
                                {
                                    <ul>@foreach (var l in samm.Read) { <li>@l</li> }</ul>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-xl-6 order-1 order-xl-2">
        <div class="graafik-paneel">
            <div class="d-flex align-items-center gap-2 mb-2">
                <button id="lahtesta" class="btn btn-sm btn-secondary">Taasta</button>
                <small class="text-muted">Kerimine suumib, lohistamine liigutab, topeltklõps taastab.</small>
            </div>
            <div class="graafik-konteiner"><canvas id="funktsiooniGraafik"></canvas></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7"></script>
    <script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1"></script>
    <script src="~/js/graafik.js"></script>
    <script>
        const valem = @Json.Serialize(u.Valem);
        joonista(valem);
        document.getElementById('lahtesta').addEventListener('click', lahtestaVaade);

        // nupu tekst vastavalt sellele, kas lahendus on lahti
        function nupuTekst(e, tekst) {
            if (!e.target.id || !e.target.id.startsWith('samm-')) return;
            const nupp = document.querySelector('[data-bs-target="#' + e.target.id + '"]');
            if (nupp) nupp.textContent = tekst;
        }
        document.addEventListener('shown.bs.collapse', e => nupuTekst(e, 'Peida lahendus'));
        document.addEventListener('hidden.bs.collapse', e => nupuTekst(e, 'Näita lahendus'));
    </script>
}
