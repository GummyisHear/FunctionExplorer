@model FunctionExplorer.Models.FunktsiooniVorm
<h1>Uus funktsioon</h1>
<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Valem" class="form-label"></label>
        <input asp-for="Valem" class="form-control" placeholder="x^3 - 3*x" />
        <span asp-validation-for="Valem" class="text-danger"></span>
    </div>
    <button class="btn btn-primary">Analüüsi ja salvesta</button>
    <button type="button" id="eelvaade" class="btn btn-secondary">Eelvaade</button>
    <a asp-action="Index" class="btn btn-link">Tagasi</a>
    <input type="hidden" asp-for="Id" />
</form>
<canvas id="funktsiooniGraafik" width="600" height="400" class="mt-3"></canvas>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/graafik.js"></script>
    <script>
        document.getElementById('eelvaade').addEventListener('click',
            () => joonista(document.getElementById('Valem').value));
    </script>
}